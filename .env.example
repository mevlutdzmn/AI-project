# ===========================================
# GooAI Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env file to version control!
# ===========================================

# Server Configuration
NODE_ENV=development
PORT=4000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/gooai_db

# JWT Configuration
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-minimum-64-characters-long-change-this-in-production

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_RESPONSES_WEB_TOOL=true

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# Email Configuration (Resend)
RESEND_API_KEY=re_your-resend-api-key

# Google Gemini (Optional)
GEMINI_API_KEY=AIzaSy-your-gemini-api-key

# Serper API for Search (Optional)
SERPER_API_KEY=your-serper-api-key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# File Upload Configuration
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=300

# Stripe Configuration (Optional)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_ID_MONTHLY=price_your-monthly-price-id
STRIPE_PRICE_ID_YEARLY=price_your-yearly-price-id

# Sentry Configuration (Optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379
